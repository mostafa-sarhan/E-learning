# Docker Compose configuration for the academy stack.
# Copy to `.env` in this directory (Compose reads it automatically for ${...} interpolation),
# then `chmod 600 .env`. Never commit `.env`.
#
# Generate secrets (hex = safe inside the MongoDB URI, no escaping needed):
#   openssl rand -hex 24   -> passwords
#   openssl rand -hex 48   -> JWT_SECRET

# Host ports (bound to 127.0.0.1 only). Check they are free: `sudo ss -ltnp`
ACADEMY_FRONTEND_PORT=8084
ACADEMY_BACKEND_PORT=5000
# Image tag for builds/rollbacks (e.g. a git commit short hash)
ACADEMY_IMAGE_TAG=latest-local

# MongoDB (root user only for administration; the app uses the least-privilege user)
MONGO_ROOT_USERNAME=academy_root
MONGO_ROOT_PASSWORD=
MONGO_APP_DB=academy
MONGO_APP_USER=academy_app
MONGO_APP_PASSWORD=

# Backend
JWT_SECRET=
JWT_EXPIRES_IN=12h
# Public origin(s) of the site, comma-separated
CORS_ORIGINS=https://academy.example.com

# Frontend: empty = same-origin /api (recommended; proxied by the frontend container)
VITE_API_URL=

# WhatsApp (session persisted in the academy-whatsapp-session volume)
WHATSAPP_ENABLED=true
# Chrome's sandbox cannot run in the hardened container; set false only if it is supported.
CHROME_NO_SANDBOX=true

# Rate limiting (optional overrides)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_API_MAX=1500
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_SENSITIVE_MAX=30
RATE_LIMIT_WHATSAPP_MAX=20
