NODE_ENV=production
# Dedicated port for this app (must not clash with LearnGate or other services)
PORT=5000
# Bind to localhost only; Nginx is the public entry point
HOST=127.0.0.1
# Separate database for the academy (do not reuse LearnGate's database)
MONGO_URI=mongodb://academy:CHANGE_ME@127.0.0.1:27017/academy?authSource=academy
# Generate with: openssl rand -hex 48  (min 32 chars)
JWT_SECRET=
JWT_EXPIRES_IN=12h
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=https://academy.example.com
# Number of trusted reverse-proxy hops (1 = behind Nginx). Leave unset when not behind a proxy.
TRUST_PROXY=1
BODY_LIMIT=100kb
# WhatsApp (whatsapp-web.js). Session directory must persist across deploys.
WHATSAPP_ENABLED=true
WHATSAPP_SESSION_PATH=/var/lib/academy/wwebjs_auth
# System Chrome/Chromium (recommended; install deps with PUPPETEER_SKIP_DOWNLOAD=true)
PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
# Rate limiting (window applies to all limiters)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_API_MAX=1500
# Failed login attempts per IP per window (successful logins are not counted)
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_SENSITIVE_MAX=30
RATE_LIMIT_WHATSAPP_MAX=20
