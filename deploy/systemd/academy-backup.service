# Daily academy MongoDB backup (online; does not stop any container).
# Install: see deploy/DEPLOYMENT.md "Scheduled backups". Replace /opt/academy and the user.
[Unit]
Description=Academy MongoDB backup
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
User=deploy
# The user must be able to run `docker compose` (member of the docker group).
WorkingDirectory=/opt/academy
Environment=RETENTION_DAYS=14
Environment=MIN_KEEP=7
ExecStart=/opt/academy/deploy/backup.sh
Nice=10
IOSchedulingClass=idle
